# Sixtec Monitor agent — {{app_name}}
# Generated by `php artisan sixtec:monitor:install`. Sends the app and server
# health to the monitor panel every minute; renews itself every hour.
[Unit]
Description=Sixtec Monitor ({{app_name}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{user}}
Group={{group}}
WorkingDirectory={{path}}
ExecStart={{php}} {{path}}/artisan sixtec:monitor:agent
Restart=always
RestartSec=10
NoNewPrivileges=true
SyslogIdentifier={{name}}

[Install]
WantedBy=multi-user.target
